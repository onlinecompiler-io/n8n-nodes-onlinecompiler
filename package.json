{
	"name": "n8n-nodes-onlinecompiler",
	"version": "0.1.0",
	"description": "n8n node for OnlineCompiler.io: run code in 46 languages in a fresh sandbox with no network, and judge it against test cases.",
	"license": "MIT",
	"homepage": "https://onlinecompiler.io",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"onlinecompiler",
		"code-execution",
		"sandbox",
		"compiler",
		"judge"
	],
	"author": {
		"name": "OnlineCompiler.io",
		"email": "hello@onlinecompiler.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/onlinecompiler-io/n8n-nodes-onlinecompiler.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/OnlineCompilerApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/OnlineCompiler/OnlineCompiler.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
